#!/bin/sh
# Knulli starts Boombrick from Ports with Boombrick.sh, beside this folder,
# which runs this script. It has no .sh, which would list it under Ports too.
PAK_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$PAK_DIR" || exit 1

# An update the app staged in .update is moved into place by renames, this
# script last, and the new script is run. One cut short by a power cut is
# finished on the next launch; a staged folder without "ready" is incomplete
# and is deleted.
if [ -f .update/ready ] && [ -z "$BOOMBRICK_UPDATED" ]; then
	(
		cd .update/pak || exit 1
		find . -type d | while read -r d; do mkdir -p "$PAK_DIR/$d"; done
		find . -type f ! -path ./launch | while read -r f; do mv -f "$f" "$PAK_DIR/$f"; done
	)
	[ -f .update/pak/launch ] && mv -f .update/pak/launch launch
	sync
	# Anything left means a rename failed; the next launch tries again.
	[ -z "$(find .update/pak -type f)" ] && rm -rf .update
	export BOOMBRICK_UPDATED=1
	exec sh ./launch
fi
[ -f .update/ready ] || rm -rf .update

export LD_LIBRARY_PATH="$PAK_DIR/lib:$LD_LIBRARY_PATH"
export BOOMBRICK_PLATFORM=knulli
# Tests give their own /var/run.
RUN_DIR="${BOOMBRICK_RUN:-/var/run}"
mkdir -p logs

# Knulli's battery saver mutes the sound after a few minutes without a
# button pressed, then suspends; a pause file holds it off while Boombrick
# is open.
PAUSE="$RUN_DIR/battery-saver/boombrick.pause"
if [ -d "$RUN_DIR/battery-saver" ]; then
	: > "$PAUSE"
fi

# The app writes its own log; this file only catches crashes before logging
# starts. A signal to this script, as Knulli sends a port it closes, goes on
# to Boombrick, which saves the queue as it quits.
./boombrick > logs/Boombrick.crash.txt 2>&1 &
pid=$!
trap 'kill -TERM "$pid" 2>/dev/null' TERM INT HUP
wait "$pid"
wait "$pid" 2>/dev/null # again, when a signal cut the first short
rm -f "$PAUSE"
